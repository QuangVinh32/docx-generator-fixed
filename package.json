{
    "name": "docx-generator",
    "version": "1.0.1",
    "private": true,
    "scripts": {
        "dev": "node scripts/dev.js",
        "dev:api": "tsx src/index.ts",
        "dev:web": "vite --host 0.0.0.0",
        "build": "npm run build:api && npm run build:web",
        "build:api": "tsc -p tsconfig.json",
        "build:web": "node scripts/build-worker-assets.js && tsc -p tsconfig.app.json && vite build",
        "start": "node dist-server/index.js"
    },
    "dependencies": {
        "docxtemplater": "^3.68.0",
        "express": "^5.2.1",
        "pizzip": "^3.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0",
        "vite": "^8.3.3",
        "wrangler": "^4.147.0"
    },
    "overrides": {
        "sharp": "^0.35.5"
    }
}
